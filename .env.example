# ローカル開発時は空のままでOK (Viteプロキシ経由で localhost:3001 に接続)
# 本番 (Vercel) ではRailwayのバックエンドURLを設定する
VITE_API_BASE_URL=https://your-backend.railway.app

# Notion連携（カレンダーページの「Notionに転記」機能に必要）
# Notion Integration Token: https://www.notion.so/my-integrations で取得
VITE_NOTION_TOKEN=secret_xxxxxxxxxxxx
# 転記先の親ページID（URLの末尾32文字）
# 現在の転記先: https://www.notion.so/36dbbfad8f088162a107c5d41ed494d1
VITE_NOTION_PARENT_PAGE_ID=36dbbfad8f088162a107c5d41ed494d1
